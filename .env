# API Configuration
VITE_API_URL=http://localhost:5000

# App Configuration
VITE_APP_NAME=CBT Admin
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Auth Configuration
VITE_TOKEN_KEY=accessToken
